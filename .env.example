# feedly-mcp — environment template
#
# ⚠️  THE SERVER DOES NOT READ .env
#
# This file is for the development scripts only — they load it explicitly with
# `node --env-file=.env`. A server started by Claude Desktop or Claude Code gets
# none of it. Setting a value here and expecting the running server to pick it up
# will not work.
#
# To configure the *running* server, use one of:
#   • ~/.config/feedly-mcp/config.toml         (persistent, applies everywhere)
#   • the "env" block in your MCP client config (per client)
#   • ~/.config/feedly-mcp/token, mode 0600     (for the token specifically)
#
# `doctor` prints every value in effect and where it came from. If a setting is
# not doing what you expect, that answers it in one command.
#
# For development:
#     cp .env.example .env && chmod 600 .env
#     node --env-file=.env scripts/smoke.mjs
#
# .env is gitignored. Never commit it, never paste its contents into an issue.
#
# Environment variables override config.toml. Full reference: docs/configuration.md


# ─── Required ────────────────────────────────────────────────────────────────

# Your Feedly developer token, from https://feedly.com/v3/auth/dev
# On a free account this expires after ~30 days and must be regenerated.
FEEDLY_TOKEN=


# ─── Optional: automatic token renewal ───────────────────────────────────────
# NOT required to run the server. Without these, you re-paste FEEDLY_TOKEN by
# hand roughly once a month.
#
# If the token page showed you a refresh token, save it here now — that page is
# unlikely to show it again. Renewal is only offered on some Feedly plans.
#
# STATUS: unverified. Renewal posts to /v3/auth/token with
# grant_type=refresh_token, which also needs OAuth client credentials. Which
# values apply to developer tokens (as opposed to a registered OAuth app) has
# not been confirmed against the live API yet. Capture what you have; the server
# will not use these until the flow is verified.

# FEEDLY_REFRESH_TOKEN=
# FEEDLY_CLIENT_ID=
# FEEDLY_CLIENT_SECRET=


# ─── Scope: which folders the agent can see ──────────────────────────────────
# Comma-separated. Accepts folder labels or raw IDs. Enforced, not cosmetic.

# Allowlist. Empty = all folders visible.
# FEEDLY_MCP_SCOPE_INCLUDE_FOLDERS=AI,Longform

# Denylist, applied after the allowlist.
# FEEDLY_MCP_SCOPE_EXCLUDE_FOLDERS=Privat,Jobb - internt

# Folder used when the agent asks for articles without naming one.
# FEEDLY_MCP_SCOPE_DEFAULT_FOLDER=AI


# ─── Tool defaults ───────────────────────────────────────────────────────────

# How far back get_articles looks. Max 744 (31 days) — Feedly returns nothing
# beyond that, so higher values are clamped.
# FEEDLY_MCP_DEFAULTS_HOURS=8

# Max articles per call.
# FEEDLY_MCP_DEFAULTS_LIMIT=100

# Skip already-read articles.
# FEEDLY_MCP_DEFAULTS_UNREAD_ONLY=true

# Summaries are trimmed to this many characters.
# FEEDLY_MCP_DEFAULTS_SUMMARY_CHARS=400

# Adds a longer summary_full field. Off by default — a single call can otherwise
# return tens of thousands of words.
# FEEDLY_MCP_DEFAULTS_FULL_TEXT=false


# ─── Budget: protects your Feedly quota ──────────────────────────────────────
# VERIFIED: a developer token on a paid Pro Plus account reports a ceiling of
# 50 calls/day, resetting near midnight UTC — NOT the 250/500 Feedly's docs
# describe. Plan for 50. Burn through it and Feedly stops working in your
# browser too, until it resets. Run `doctor` to see your own ceiling.

# Daily ceiling. Leaves headroom out of 50 for your own browsing.
# FEEDLY_MCP_BUDGET_DAILY_CALLS=40

# Per-session ceiling, so one runaway conversation can't spend the whole day.
# FEEDLY_MCP_BUDGET_SESSION_CALLS=10

# Below this many remaining calls, every response carries a visible warning.
# FEEDLY_MCP_BUDGET_WARN_BELOW=10


# ─── Cache: quota hygiene, not an archive ────────────────────────────────────
# Everything here expires on a timer and none of it is searchable.

# Folder and subscription lists. These almost never change, and refetching them
# four times a day would spend 8 of your 50 calls on nothing.
# FEEDLY_MCP_CACHE_METADATA_TTL=24h

# Identical article requests. Ask twice in one conversation, pay for one call.
# FEEDLY_MCP_CACHE_ARTICLES_TTL=15m

# FEEDLY_MCP_CACHE_DIR=~/.cache/feedly-mcp


# ─── Writes: permanent, no undo ──────────────────────────────────────────────
# Feedly has no undo for marking articles read. Recovery means emailing support.

# Allows mark_read with an explicit list of article IDs.
# FEEDLY_MCP_WRITES_ENABLED=false

# Additionally allows marking an entire folder read — thousands of articles from
# one tool call. Requires the above to be true as well. Think about this one.
# FEEDLY_MCP_WRITES_BULK_MARK_READ=false


# ─── Advanced ────────────────────────────────────────────────────────────────

# Only change if you're on an Enterprise tenant with a different host.
# FEEDLY_MCP_FEEDLY_API_BASE=https://api.feedly.com
